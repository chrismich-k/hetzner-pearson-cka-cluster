# --- Terraform ---
# provider plugins / module cache
.terraform/
# state contains server IPs, IDs and possibly secrets
*.tfstate
*.tfstate.*
crash.log
crash.*.log
# saved plans can contain secrets as well
*.tfplan
tfplan
# real variable values (hcloud_token!) - only the .example gets committed
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# .terraform.lock.hcl is intentionally NOT ignored (pins provider versions)

# --- Ansible ---
.venv/
*.retry
.ansible/
__pycache__/
*.pyc

# --- secrets that should never end up here ---
*.pem
*.key
id_rsa*
id_ed25519*
.env

# --- editors / OS ---
.vscode/
.idea/
*.swp
*~
.DS_Store
